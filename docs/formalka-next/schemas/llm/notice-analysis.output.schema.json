{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formalka-next/llm/notice-analysis.output",
  "title": "Analysis of a letter from an authority (later phase). Every value is a candidate the user confirms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["noticeType", "issuingOffice", "datesFound", "requestedItems", "matchedRule", "confidence"],
  "properties": {
    "noticeType": { "enum": ["request_to_supplement", "summons", "decision", "other", "unknown"] },
    "issuingOffice": { "type": ["string", "null"] },
    "datesFound": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["date", "label", "evidence"],
        "properties": { "date": { "type": "string" }, "label": { "type": "string" }, "evidence": { "type": "string" } } }
    },
    "requestedItems": { "type": "array", "items": { "type": "string" } },
    "matchedRule": { "type": ["string", "null"], "description": "Registry rule that governs the response deadline; the deadline itself is computed by code" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
